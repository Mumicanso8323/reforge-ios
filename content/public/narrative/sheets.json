            "expr": "fact.test.device_fixed"
          }
        },
        "refuseWhen": [
          {
            "ideologyAtLeast": {
              "axis": "axis.test.guard",
              "value": 2
            }
          }
        ],
        "tags": [
          "tag.test.build"
        ]
      }
    },
    {
      "id": "sheet.test.verse",
      "title": "sheet:sheet.test.verse",
      "when": {
        "always": {}
      },
      "rows": [
        {
          "id": "line.make",
          "subject": "misc:test.line_make",
          "answer": {
            "accepts": [
              {
                "act": "crafted"
              },
              {
                "act": "trialed"
              }
            ]
          },
          "measure": {
            "count": {
              "query": {
                "act": "crafted"
              }
            }
          }
        },
        {
          "id": "line.keep",
          "subject": "misc:test.line_keep",
          "answer": {
            "accepts": [
              {
                "act": "died"
              },
              {
                "act": "joined"
              }
            ]
          },
          "measure": {
            "maxDetail": {
              "query": {
                "act": "crafted"
              },
              "key": "purity"
            }
          }
        }
      ]
    },
    {
      "id": "sheet.test.manifest",
      "title": "sheet:sheet.test.manifest",
      "rows": [],
      "when": {
        "known": {
          "expr": "fact.test.vessel_ready"
        }
      },
      "manifest": {
        "capacity": 2,
        "leanings": [
          {
            "tests": [
              {
                "ideologyAtLeast": {
                  "axis": "axis.test.make",
                  "value": 3
                }
              }
            ],
            "aboard": false,
            "firm": true
          },
          {
            "tests": [
              {
                "member": {}
              }
            ],
            "aboard": true
          }
        ]
      }
    }
  ],
  "events": [
    {
      "id": "event.test.gap_seen",
      "trigger": {
        "on": [
