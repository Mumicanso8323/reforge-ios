    {
      "id": "sheet.test.ledger",
      "title": "sheet:sheet.test.ledger",
      "rows": [],
      "when": {
        "known": {
          "expr": "fact.test.device_fixed"
        }
      },
      "slots": 6,
      "entries": [
        {
          "slot": 1,
          "subject": "misc:test.entry1"
        },
        {
          "slot": 2,
          "subject": "person:person.test_a",
          "person": "person.test_a"
        },
        {
          "slot": 3,
          "subject": "person:person.test_b",
          "person": "person.test_b"
        },
        {
          "slot": 5,
          "subject": "misc:test.entry5"
        },
        {
          "slot": 6,
          "subject": "misc:test.entry6"
        }
